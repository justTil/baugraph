{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the VS Code extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../examples"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "Build the extension (debug)"
    }
  ]
}
