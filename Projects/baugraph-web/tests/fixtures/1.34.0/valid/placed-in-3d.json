{
  "$schema": "/schema/baugraph-v1.schema.json",
  "baugraph": "1.0",
  "meta": {
    "title": "Checkout — arranged in 3D",
    "description": "position3d: a zone moved in 3D carries what it holds; one node inside it is placed on its own, one outside stands where the canvas has it."
  },
  "canvas": {
    "theme": "light",
    "grid": true,
    "snap": true,
    "snapSize": 10
  },
  "planes": [
    { "id": "data", "label": "Data tier", "color": "green" },
    { "id": "application", "label": "Application tier", "color": "blue" }
  ],
  "nodes": [
    {
      "id": "orders-db",
      "label": "Orders",
      "shape": "cylinder",
      "position": { "x": 160, "y": 420 },
      "size": { "width": 190, "height": 62 },
      "plane": "data"
    },
    {
      "id": "services",
      "kind": "zone",
      "label": "Services",
      "position": { "x": 60, "y": 60 },
      "size": { "width": 460, "height": 260 },
      "plane": "application",
      "position3d": { "x": 860, "y": -120, "z": 40 }
    },
    {
      "id": "checkout",
      "label": "Checkout",
      "position": { "x": 40, "y": 70 },
      "size": { "width": 190, "height": 62 },
      "parent": "services"
    },
    {
      "id": "pricing",
      "label": "Pricing",
      "position": { "x": 250, "y": 70 },
      "size": { "width": 190, "height": 62 },
      "parent": "services",
      "position3d": { "x": 1300, "y": 260, "z": 120.5 },
      "extrusion": "tall"
    }
  ],
  "edges": [
    {
      "id": "checkout--orders-db",
      "source": "checkout",
      "target": "orders-db"
    },
    {
      "id": "checkout--pricing",
      "source": "checkout",
      "target": "pricing",
      "label": "quote"
    }
  ]
}
