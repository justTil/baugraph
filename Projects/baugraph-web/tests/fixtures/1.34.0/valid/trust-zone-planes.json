{
  "$schema": "/schema/baugraph-v1.schema.json",
  "baugraph": "1.0",
  "meta": {
    "title": "Payments — trust zones",
    "description": "3D planes: a zone carries its nodes onto its plane, and one node inside it stands on a plane of its own."
  },
  "canvas": {
    "theme": "light",
    "grid": true,
    "snap": true,
    "snapSize": 10
  },
  "planes": [
    { "id": "data", "label": "Data tier", "color": "green" },
    { "id": "application", "label": "Application tier", "color": "blue" },
    { "id": "dmz", "label": "DMZ", "color": "amber" },
    { "id": "external", "label": "External" }
  ],
  "nodes": [
    {
      "id": "core",
      "kind": "zone",
      "label": "Core",
      "position": { "x": 480, "y": 60 },
      "size": { "width": 460, "height": 320 },
      "plane": "application"
    },
    {
      "id": "fraud",
      "type": "service",
      "label": "Fraud Check",
      "color": "red",
      "position": { "x": 240, "y": 60 },
      "size": { "width": 190, "height": 62 },
      "parent": "core",
      "extrusion": "low"
    },
    {
      "id": "ledger",
      "type": "database",
      "tech": "postgresql",
      "label": "Ledger",
      "shape": "cylinder",
      "color": "green",
      "position": { "x": 30, "y": 200 },
      "size": { "width": 190, "height": 80 },
      "parent": "core",
      "plane": "data",
      "extrusion": "tower"
    },
    {
      "id": "payments",
      "type": "service",
      "label": "Payment Service",
      "color": "blue",
      "position": { "x": 30, "y": 60 },
      "size": { "width": 190, "height": 62 },
      "parent": "core"
    },
    {
      "id": "customer",
      "type": "user",
      "label": "Customer",
      "shape": "circle",
      "position": { "x": 40, "y": 160 },
      "size": { "width": 100, "height": 100 },
      "plane": "external"
    },
    {
      "id": "gateway",
      "type": "api_gateway",
      "tech": "kong",
      "label": "API Gateway",
      "color": "amber",
      "position": { "x": 220, "y": 180 },
      "size": { "width": 190, "height": 62 },
      "plane": "dmz",
      "extrusion": "tall"
    },
    {
      "id": "note",
      "kind": "annotation",
      "label": "PCI scope",
      "shape": "text",
      "position": { "x": 220, "y": 300 },
      "size": { "width": 120, "height": 40 },
      "extrusion": "flat"
    }
  ],
  "edges": [
    {
      "id": "customer--gateway",
      "source": "customer",
      "target": "gateway",
      "label": "HTTPS"
    },
    {
      "id": "gateway--payments",
      "source": "gateway",
      "target": "payments"
    },
    {
      "id": "payments--fraud",
      "source": "payments",
      "target": "fraud",
      "line": "dashed"
    },
    {
      "id": "payments--ledger",
      "source": "payments",
      "target": "ledger",
      "label": "write"
    }
  ],
  "flows": [
    {
      "id": "flow-payment",
      "label": "Payment",
      "edges": ["customer--gateway", "gateway--payments", "payments--fraud", "payments--ledger"],
      "token": "envelope"
    }
  ]
}
