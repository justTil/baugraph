      "targetSide": "top"
    }
  ],
  "flows": [
    {
      "id": "flow-start",
      "label": "Start",
      "edges": ["start--step"],
      "speed": 100,
      "count": 10,
      "stream": true
    },
    {
      "id": "flow-start-2",
      "label": "Start",
      "edges": ["start--decision", "decision--step"],
      "color": "purple"
    }
