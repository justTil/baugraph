{
  "$schema": "/schema/baugraph-v1.schema.json",
  "baugraph": "1.0",
  "meta": {
    "title": "Untitled diagram"
  },
  "canvas": {
    "theme": "light",
    "grid": true,
    "snap": true,
    "snapSize": 10
  },
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "Start",
      "shape": "pill",
      "icon": "play",
      "position": { "x": 140, "y": 190 },
      "size": { "width": 130, "height": 56 }
    },
    {
      "id": "step",
      "type": "step",
      "label": "Step",
      "position": { "x": 550, "y": 184 },
      "size": { "width": 150, "height": 62 }
    },
    {
      "id": "decision",
      "type": "decision",
      "label": "Decision",
