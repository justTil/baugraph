{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the VS Code extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "Build the extension (debug)"
    },
    {
      "name": "Run the VS Code extension (no rebuild)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/examples"
      ],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"]
    }
  ]
}
