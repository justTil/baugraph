    {
      "id": "nightly-reconcile--order-service",
      "source": "nightly-reconcile",
      "target": "order-service",
      "sourceSide": "right",
      "targetSide": "left",
      "label": "trigger",
      "line": "dashed",
      "color": "teal"
    },
    {
      "id": "nightly-reconcile--sftp-export",
      "source": "nightly-reconcile",
      "target": "sftp-export",
      "sourceSide": "bottom",
      "targetSide": "top",
      "label": "writes",
      "color": "teal"
